# ------------------------------------------------------------
# 연동 정보 (개발 계획 4단계에서 입력)
# 이 파일을 복사해 .env 로 만들고 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# 주의: EXPO_PUBLIC_ 로 시작하는 값은 앱 번들에 그대로 포함됩니다.
#       비밀키(서버 시크릿, 결제 시크릿 등)는 절대 넣지 마세요.
# ------------------------------------------------------------

# true = 목업 데이터 사용 (서버 없이 개발), false = 실제 서버 호출
EXPO_PUBLIC_USE_MOCK=true

# true(기본) = 개발 빌드에서 가입/로그인을 건너뛰고 목업 사용자로 바로 지도 탭 진입
EXPO_PUBLIC_DEV_SKIP_AUTH=true

# 백엔드
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_WS_URL=wss://ws.example.com

# 소셜 로그인 (4단계)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_X_CLIENT_ID=

# 지도 (4단계: Google / 8단계: 네이버, Mapbox)
# Google Maps 키는 네이티브 설정(app.config.ts)에만 들어가므로 EXPO_PUBLIC_ 를 붙이지 않습니다.
# Expo Go 에서는 Expo 자체 키로 지도가 보이고, 이 키는 개발 빌드/출시 빌드에서 사용됩니다.
GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# 광고 (6단계)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
