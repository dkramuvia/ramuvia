# 복사해서 .env 로 사용 (.env 는 git 에 올리지 않음). 서버에서는 반드시 다른 비밀번호로.

NODE_ENV=development
API_PORT=3000

# --- PostgreSQL (docker compose 의 db) ---
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
APP_MAIN_PASSWORD=change-me-main
APP_LOCATION_PASSWORD=change-me-location

# 앱이 쓰는 연결 (PC 에서 npm run start:dev 할 때)
MAIN_DATABASE_URL=postgres://app_main:change-me-main@127.0.0.1:5432/ramupin
# ★ 위치 DB 를 다른 서버로 옮길 때는 이 주소만 바꿉니다
LOCATION_DATABASE_URL=postgres://app_location:change-me-location@127.0.0.1:5432/ramupin_location

# 마이그레이션(테이블 생성·변경) 전용 관리자 연결
MIGRATOR_MAIN_URL=postgres://postgres:change-me-postgres@127.0.0.1:5432/ramupin
MIGRATOR_LOCATION_URL=postgres://postgres:change-me-postgres@127.0.0.1:5432/ramupin_location

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379

# --- 인증 ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=60
# 문자 발송 업체. dev = 로그에만 출력, 인증번호 123456 (서버에서는 사용 불가)
SMS_PROVIDER=dev

# --- 카카오 로그인 ---
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 설정 > 요약 정보의 앱 ID
KAKAO_APP_ID=0

# --- 전화번호 보관 ---
# 32바이트 base64. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ★ 운영에서 바뀌면 기존 가입자의 번호를 읽지 못합니다
PHONE_ENC_KEY=change-me-32-bytes-base64
PHONE_HASH_KEY=change-me-32-bytes-base64
# 개발용 로그인(POST /auth/dev-login) 허용. 서버에서는 반드시 false
DEV_LOGIN_ENABLED=true
# X(트위터) OAuth 2.0 Client ID (developer.x.com > Projects & Apps > User authentication settings)
X_CLIENT_ID=
# Firebase 서비스 계정 키 파일 경로 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키)
FIREBASE_SERVICE_ACCOUNT_FILE=

# 사진·동영상 저장소 (개발: Docker MinIO / 운영: AWS S3)
# 운영으로 옮길 때 이 4개만 바꾸면 서버 코드는 그대로입니다
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=ramupin-media
STORAGE_ACCESS_KEY=ramupin-dev
STORAGE_SECRET_KEY=change-me-8자이상
# 앱이 파일을 주고받을 때 쓸 주소. 폰에서 접속 가능한 주소여야 합니다 (비우면 STORAGE_ENDPOINT 사용)
STORAGE_PUBLIC_URL=
