@@ -0,0 +1,80 @@
+package expo.modules.location
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import expo.modules.interfaces.taskManager.TaskServiceInterface
+import expo.modules.location.taskConsumers.LocationTaskConsumer
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * ramupin 패치: 폰을 켜면 위치 수집을 다시 켭니다.
+ *
+ * expo-task-manager 가 부팅 때 저장된 작업을 되살려야 하는데, 실기기(갤럭시 노트20, 안드로이드 13)에서
+ * 되살리지 않아 재부팅 뒤 앱을 열기 전까지 위치가 하나도 올라가지 않았습니다 (10-13).
+ * 그래서 수집을 켤 때 설정을 따로 저장해 두고(LocationModule.saveForBoot), 부팅 신호를 받으면
+ * 그 설정으로 직접 다시 등록합니다. 안드로이드는 부팅 직후 잠깐 백그라운드에서도 위치 서비스를
+ * 띄우도록 허용하므로 여기서 바로 시작해야 합니다 (LocationTaskConsumer.maybeStartForegroundService).
+ */
+class RamupinBootReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    if (intent.action != Intent.ACTION_BOOT_COMPLETED && intent.action != Intent.ACTION_MY_PACKAGE_REPLACED) return
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    val taskName = prefs.getString(KEY_TASK, null) ?: return
+    val optionsJson = prefs.getString(KEY_OPTIONS, null) ?: return
+    val scope = prefs.getString(KEY_SCOPE, null) ?: context.packageName
+    val url = prefs.getString(KEY_URL, null) ?: context.packageName
+    try {
+      val service = Class.forName("expo.modules.taskManager.TaskService")
+        .getConstructor(Context::class.java)
+        .newInstance(context.applicationContext) as TaskServiceInterface
+      if (service.taskHasConsumerOfClass(taskName, scope, LocationTaskConsumer::class.java)) {
+        Log.i(TAG, "location task already registered on ${intent.action}")
+        return
+      }
+      service.registerTask(taskName, scope, url, LocationTaskConsumer::class.java, toMap(JSONObject(optionsJson)))
+      Log.i(TAG, "location task restored on ${intent.action}")
+    } catch (e: Exception) {
+      Log.w(TAG, "could not restore location task: ${e.message}")
+    }
+  }
+
+  companion object {
+    private const val TAG = "RamupinBootReceiver"
+    private const val PREFS = "ramupin-location-boot"
+    private const val KEY_TASK = "taskName"
+    private const val KEY_OPTIONS = "options"
+    private const val KEY_SCOPE = "appScopeKey"
+    private const val KEY_URL = "appUrl"
+
+    /** 수집을 켤 때 부릅니다. 부팅 때 같은 설정으로 다시 켜기 위해 */
+    fun save(context: Context, taskName: String, options: Map<String, Any?>) {
+      context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+        .putString(KEY_TASK, taskName)
+        .putString(KEY_OPTIONS, JSONObject(options).toString())
+        .putString(KEY_SCOPE, context.packageName)
+        .putString(KEY_URL, context.packageName)
+        .apply()
+    }
+
+    /** 수집을 끌 때 부릅니다. 끈 사람의 폰이 재부팅 뒤 다시 켜지면 안 됩니다 */
+    fun clear(context: Context) {
+      context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().clear().apply()
+    }
+
+    private fun toMap(json: JSONObject): MutableMap<String, Any?> {
+      val map = HashMap<String, Any?>()
+      for (key in json.keys()) map[key] = unwrap(json.get(key))
+      return map
+    }
+
+    private fun unwrap(value: Any?): Any? = when (value) {
+      is JSONObject -> toMap(value)
+      is JSONArray -> (0 until value.length()).map { unwrap(value.get(it)) }
+      JSONObject.NULL -> null
+      else -> value
+    }
+  }
+}
